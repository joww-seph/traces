{
  "name": "@traces/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --noEmit -p . && esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --alias:@traces/shared=../shared/src/index.ts --outfile=dist/index.js",
    "start": "node dist/index.js",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "seed:superadmin": "tsx src/scripts/seed-superadmin.ts",
    "seed:dev": "tsx src/scripts/seed-dev.ts",
    "backup": "tsx src/scripts/backup.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@traces/shared": "*",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
