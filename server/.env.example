PORT=3000
NODE_ENV=development
DATABASE_URL=postgres://traces:traces@127.0.0.1:5432/traces_dev
TEST_DATABASE_URL=postgres://traces:traces@127.0.0.1:5432/traces_test
# 64+ random characters; generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-64-random-chars
# Comma-separated addresses the browser is allowed to call from (the Origin check). `npm run lan` fills in this laptop's address.
APP_ORIGIN=http://localhost:5173
STORAGE_DIR=./storage
PUBLIC_RATE_LIMIT_PER_MIN=60
# Failed-login limit per IP + email in 15 minutes (kept in memory, so run one API process)
LOGIN_RATE_LIMIT=10
# Cookies are Secure (HTTPS only) in production. Set false only to run a production build over plain http on a LAN demo.
# COOKIE_SECURE=false
